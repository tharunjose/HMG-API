{
  "id": "creta-auto-vent",
  "name": "Creta RHD driver ventilation test",
  "version": "0.1.1",
  "hmgapi": ">=1.0.1",
  "authors": [
    "Creta diesel port"
  ],
  "license": "AGPL-3.0",
